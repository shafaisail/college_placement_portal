# ============================================
# College Placement Portal - Environment Configuration
# ============================================

# --- BACKEND SETTINGS ---
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Replace with your Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/placement_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/placement_portal

# JWT Security
JWT_SECRET=super_secret_placement_portal_jwt_token_key_change_in_production
JWT_EXPIRE=7d

# Microservice & Client URLs
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Initial Seed Admin Account
ADMIN_NAME=Head TPO Officer
ADMIN_EMAIL=admin@placement.edu
ADMIN_PASSWORD=AdminPass@2026
ADMIN_DEPARTMENT=Training & Placement Cell

# --- FRONTEND SETTINGS ---
VITE_API_URL=http://localhost:5000/api

# --- AI SERVICE SETTINGS ---
AI_PORT=8000
AI_HOST=0.0.0.0
