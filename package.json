{
  "name": "college-placement-portal",
  "version": "1.0.0",
  "description": "Production AI-Powered College Placement Portal (MERN + Python FastAPI)",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "python ai-service/app.py",
    "dev": "concurrently -n \"BACKEND,FRONTEND,AI\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ai\"",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:frontend",
    "start": "node backend/server.js",
    "test:backend": "npm --prefix backend run test",
    "test:ai": "python -m unittest ai-service/tests/test_ai_service.py",
    "test": "npm run test:backend && npm run test:ai",
    "seed": "node backend/utils/seedAdmin.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "mern",
    "college-placement",
    "fastapi",
    "ai",
    "resume-analysis",
    "job-recommendation"
  ],
  "author": "Campus Placement Cell",
  "license": "ISC"
}
